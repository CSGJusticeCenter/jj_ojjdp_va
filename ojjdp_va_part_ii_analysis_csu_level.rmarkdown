                    `Unique Youth w/ Unsuccessful Diversion (with petition) (N)` = n_distinct(juvenile_number[diversion_not_successful_petition_flag==1]),
                    `Unsuccessful Diversion with petition (%)` = scales::percent(`Unique Youth w/ Unsuccessful Diversion (with petition) (N)`/`Unique Youth Diverted (N)`,
                                                                       accuracy = .1)) %>% 
  dplyr::mutate(`CSU` = "Overall")
 


# Maps

**Note:** All maps currently visualize the percentage all all complaints/cases, regardless of intake decision, that are petitioned. 


```{r include=FALSE,message=FALSE,warning=FALSE}
### read in census/acs api key from environmnent
### this allows us to pull census/acs data via the tidycensus package
readRenviron("~/.Renviron")

### read in va county-level shape file and keep geometry for mapping
### from kyle walker/tidycensus: specify cb = TRUE which defaults to the Census Bureau’s cartographic boundary shapefiles. Cartographic boundary shapefiles are preferred to the core TIGER/Line shapefiles in tidycensus as their smaller size speeds up processing and because they are pre-clipped to the US coastline.
va_county_shoreline_clipped <- get_acs(
  geography = "county",
  variables = "B19013_001",
  state = "VA",
  year = 2020,
  geometry = TRUE,
  cb = TRUE
  ) %>%
  clean_names() %>%
  group_by(geoid) %>%
  summarize(geometry = st_union(geometry)) %>%
  ungroup() %>% 
  mutate(state = "VA")

### read in va county-level shape file with fips codes to use as lookup table
va_county_shape <- read_sf("C:\\Users\\abyrum\\OneDrive - The Council of State Governments\\Geospatial_Mapping\\US County Geo Data\\tl_2019_us_county\\tl_2019_us_county.shp") %>%
  clean_names() %>%
  filter(statefp=="51") %>% ### filter by state fip code
  dplyr::select(county=name,
               county_fip=countyfp,
               geoid)

### lose geometry as this is just a lookup table
va_county_lookup <- as.data.frame(va_county_shape) %>% 
    dplyr::select(-(geometry))

### now join va_county_shoreline_clipped and va_county_lookup
va_county_shoreline_clipped_final <- left_join(va_county_shoreline_clipped,
                                               va_county_lookup,
                                               by = "geoid")

### add geometry to counts of complaints, diversions, and petitions by county, csu, and csu region
df_complaints_youth_intake_decision_county_to_join <- df_analytic_complaints_disposition_caseload %>%
  mutate(csu = ifelse(fips_code=="X71",
                            "027",csu),
         csu = ifelse(fips_code=="X21",
                            "027",csu)) %>%
  mutate(fips_code = ifelse(fips_code=="X71",
                            "071",fips_code),
         fips_code = ifelse(fips_code=="X21",
                            "021",fips_code)) %>%
  dplyr::group_by(fips_code,csu,csu_region) %>%
  dplyr::summarise(`All Complaints (N)` = n_distinct(unique_complaint_id),
                   `Complaints Diverted (N)` = n_distinct(unique_complaint_id[intake_diverted_flag=="Yes"]),
                   `Complaints Petitioned (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Petitioned"]),
                   `Complaints Resolved/Dismissed (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Resolved/Dismissed"])) %>%
  ungroup()

### join geometry to file
df_county_level_intake_complaints_summary_geo <- left_join(va_county_shoreline_clipped_final,
                                                     df_complaints_youth_intake_decision_county_to_join,
                                                     by = c("county_fip"="fips_code"))
```

```{r include=FALSE,message=FALSE,warning=FALSE}
### set constants for mapping
default_font_color <- "#4e4d47"
default_font_family <- "Franklin Gothic Book"
```

```{r include=FALSE,message=FALSE,warning=FALSE}
### create static map theme (based on https://timogrossenbacher.ch/2019/04/bivariate-maps-with-ggplot2-and-sf/)
theme_map <- function(...) {
  theme_minimal() +
  theme(
    text = element_text(family = default_font_family,
                        color = default_font_color),
    # remove all axes
    axis.line = element_blank(),
    axis.text.x = element_blank(),
    axis.text.y = element_blank(),
    axis.ticks = element_blank(),
    # add a subtle grid
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank(),
    # borders and margins
    plot.margin = unit(c(.5, .5, .2, .5), "cm"),
    panel.border = element_blank(),
    panel.spacing = unit(c(-.1, 0.2, .2, 0.2), "cm"),
    # titles
    legend.title = element_text(size = 11),
    legend.text = element_text(size = 9, hjust = 0,
                               color = default_font_color),
    plot.title = element_text(size = 15, hjust = 0.5,
                              color = default_font_color),
    # plot.subtitle = element_text(size = 10, hjust = 0.5,
    #                              color = default_font_color,
    #                              margin = margin(b = -0.1,
    #                                              t = -0.1,
    #                                              l = 2,
    #                                              unit = "cm"),
    #                              debug = F),
    # # captions
    # plot.caption = element_text(size = 7,
    #                             hjust = .5,
    #                             margin = margin(t = 0.2,
    #                                             b = 0,
    #                                             unit = "cm"),
    #                             color = default_font_color),
    ...
  )
}
```

```{r include=FALSE,message=FALSE,warning=FALSE}
### set sharepoint path using csgjcr function
sharepoint_ojjdp_va_analysis_geo_data <- csgjcr::csg_sp_path(file.path("JJ_OJJDP/Data/VA/analysis/geo"))

### group diversion, petition, and resolved/dismissed rate and geometry by county
df_complaints_youth_intake_decision_county_to_join <- df_analytic_complaints_disposition_caseload %>%
  mutate(fips_code = ifelse(fips_code=="X71",
                            "071",fips_code),
         fips_code = ifelse(fips_code=="X21",
                            "021",fips_code)) %>%
  dplyr::group_by(fips_code) %>%
  dplyr::summarise(`All Complaints (N)` = n_distinct(unique_complaint_id),
                   `Complaints Diverted (N)` = n_distinct(unique_complaint_id[intake_diverted_flag=="Yes"]),
                   `Complaints Diverted (row %)` = n_distinct(unique_complaint_id[intake_diverted_flag=="Yes"])/`All Complaints (N)`,
                   `Complaints Petitioned (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Petitioned"]),
                   `Complaints Petitioned (row %)` = n_distinct(unique_complaint_id[intake_decision_clean=="Petitioned"])/`All Complaints (N)`,
                   `Complaints Resolved/Dismissed (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Resolved/Dismissed"]),
                   `Complaints Resolved/Dismissed (row %)` = n_distinct(unique_complaint_id[intake_decision_clean=="Resolved/Dismissed"])/`All Complaints (N)`) %>%
  ungroup()

df_county_level_intake_summary_geo <- left_join(va_county_shoreline_clipped_final,
                                                df_complaints_youth_intake_decision_county_to_join,
                                                     by = c("county_fip"="fips_code"))

### write out as rds file (to save time)
write_rds(df_county_level_intake_summary_geo,
          file.path(sharepoint_ojjdp_va_analysis_geo_data,"df_county_level_intake_summary_geo.rds"))

### read in rds file for diversion rate and geometry by county
df_county_level_intake_summary_geo <- read_rds(file.path(sharepoint_ojjdp_va_analysis_geo_data,"df_county_level_intake_summary_geo.rds"))

### group diversion rate and geometry by csu
df_csu_level_intake_summary_geo <- df_county_level_intake_complaints_summary_geo %>%
  dplyr::group_by(csu) %>%
  dplyr::summarise(`All Complaints (N)` = sum(`All Complaints (N)`),
                   `Complaints Diverted (N)` = sum(`Complaints Diverted (N)`),
                   `Complaints Diverted (row %)` = `Complaints Diverted (N)`/`All Complaints (N)`,
                   `Complaints Petitioned (N)` = sum(`Complaints Petitioned (N)`),
                   `Complaints Petitioned (row %)` = `Complaints Petitioned (N)`/`All Complaints (N)`,
                   `Complaints Resolved/Dismissed (N)` = sum(`Complaints Resolved/Dismissed (N)`),
                   `Complaints Resolved/Dismissed (row %)` = `Complaints Resolved/Dismissed (N)`/`All Complaints (N)`,
                   geometry = st_union(geometry)) %>%
  ungroup()

### write out as rds file (to save time)
write_rds(df_csu_level_intake_summary_geo,
          file.path(sharepoint_ojjdp_va_analysis_geo_data,"df_csu_level_intake_summary_geo.rds"))

### read in rds file for diversion rate and geometry by csu
df_csu_level_intake_summary_geo <- read_rds(file.path(sharepoint_ojjdp_va_analysis_geo_data,"df_csu_level_intake_summary_geo.rds"))

### group diversion rate and geometry by csu region
### we will initially use this file to add a region layer/label to the map
df_csu_region_level_intake_summary_geo <- df_county_level_intake_complaints_summary_geo %>%
  dplyr::group_by(csu_region) %>%
  dplyr::summarise(`All Complaints (N)` = sum(`All Complaints (N)`),
                   `Complaints Diverted (N)` = sum(`Complaints Diverted (N)`),
                   `Complaints Diverted (row %)` = `Complaints Diverted (N)`/`All Complaints (N)`,
                   `Complaints Petitioned (N)` = sum(`Complaints Petitioned (N)`),
                   `Complaints Petitioned (row %)` = `Complaints Petitioned (N)`/`All Complaints (N)`,
                   `Complaints Resolved/Dismissed (N)` = sum(`Complaints Resolved/Dismissed (N)`),
                   `Complaints Resolved/Dismissed (row %)` = `Complaints Resolved/Dismissed (N)`/`All Complaints (N)`,
                   geometry = st_union(geometry)) %>%
  ungroup()

### write out as rds file (to save time)
write_rds(df_csu_region_level_intake_summary_geo,
          file.path(sharepoint_ojjdp_va_analysis_geo_data,"df_csu_region_level_intake_summary_geo.rds"))

### read in rds file for diversion rate and geometry by csu region
df_csu_region_level_intake_summary_geo <- read_rds(file.path(sharepoint_ojjdp_va_analysis_geo_data,"df_csu_region_level_intake_summary_geo.rds"))

```



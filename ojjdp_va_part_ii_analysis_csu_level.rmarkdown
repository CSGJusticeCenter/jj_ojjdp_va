## Table 7a: Disposition Outcomes by YASI Risk Level

**TO DO:** Double check that I’m using correct YASI assessment for dispo exploration (does it matter if it is initial, case closure, etc.?)


**BUSINESS RULE:** Filtering on non-missing dispositions and non-missing YASI values for this analysis


Note: The preliminary options for grouping dispositions that I am using are: Detention, Commitment, Probation/Supervision, Deferral, Community Service, Fine, No further action/none, Restitution, Other. See the `Disposition, Preliminary Disposition Groupings` table on the `codebook` page in the `sample descriptives` tab for a full list of each disposition and I've grouped it. 


```{r echo=FALSE,message=FALSE,warning=FALSE}
#| column: page-right
#| out-width: 85%

### unique complaints split out
df_complaints_disposition_outcome_table_risk_score <- df_analytic_complaints_disposition_caseload %>% 
  filter(!is.na(dispo_description_clean),
         !is.na(risk_level_clean)) %>% 
  dplyr::group_by(csu) %>% 
  dplyr::summarise(`All Disposed Complaints (N)` = n_distinct(unique_complaint_id),
                   `Probation/Supervision (N)` = n_distinct(unique_complaint_id[dispo_description_clean=="Probation/Supervision"]),
                   `Probation/Supervision (row % of all dispositions)` = scales::percent(`Probation/Supervision (N)`/`All Disposed Complaints (N)`,
                                                                       accuracy = .1),
                   `Probation/Supervision, Low Risk (N)` = n_distinct(unique_complaint_id[dispo_description_clean=="Probation/Supervision" & risk_level_clean=="Low"]),
                   `Probation/Supervision, Low Risk (row % of probation/supervision)` = scales::percent(`Probation/Supervision, Low Risk (N)`/`Probation/Supervision (N)`,
                                                                       accuracy = .1),
                   `Probation/Supervision, Medium Risk (N)` = n_distinct(unique_complaint_id[dispo_description_clean=="Probation/Supervision" & risk_level_clean=="Medium"]),
                   `Probation/Supervision, Medium Risk (row % of probation/supervision)` = scales::percent(`Probation/Supervision, Medium Risk (N)`/`Probation/Supervision (N)`,
                                                                       accuracy = .1),
                   `Probation/Supervision, High Risk (N)` = n_distinct(unique_complaint_id[dispo_description_clean=="Probation/Supervision" & risk_level_clean=="High"]),
                   `Probation/Supervision, High Risk (row % of probation/supervision)` = scales::percent(`Probation/Supervision, High Risk (N)`/`Probation/Supervision (N)`,
                                                                       accuracy = .1)) %>% 
  ungroup() %>% 
  dplyr::rename(`CSU` = csu) 

### unique complaints statewide
df_complaints_disposition_outcome_table_overall <- df_analytic_complaints_disposition_caseload %>% 
  filter(!is.na(dispo_description_clean),
         !is.na(risk_level_clean)) %>% 
  dplyr::summarise(`All Disposed Complaints (N)` = n_distinct(unique_complaint_id),
                   `Probation/Supervision (N)` = n_distinct(unique_complaint_id[dispo_description_clean=="Probation/Supervision"]),
                   `Probation/Supervision (row % of all dispositions)` = scales::percent(`Probation/Supervision (N)`/`All Disposed Complaints (N)`,
                                                                       accuracy = .1),
                   `Probation/Supervision, Low Risk (N)` = n_distinct(unique_complaint_id[dispo_description_clean=="Probation/Supervision" & risk_level_clean=="Low"]),
                   `Probation/Supervision, Low Risk (row % of probation/supervision)` = scales::percent(`Probation/Supervision, Low Risk (N)`/`Probation/Supervision (N)`,
                                                                       accuracy = .1),
                   `Probation/Supervision, Medium Risk (N)` = n_distinct(unique_complaint_id[dispo_description_clean=="Probation/Supervision" & risk_level_clean=="Medium"]),
                   `Probation/Supervision, Medium Risk (row % of probation/supervision)` = scales::percent(`Probation/Supervision, Medium Risk (N)`/`Probation/Supervision (N)`,
                                                                       accuracy = .1),
                   `Probation/Supervision, High Risk (N)` = n_distinct(unique_complaint_id[dispo_description_clean=="Probation/Supervision" & risk_level_clean=="High"]),
                   `Probation/Supervision, High Risk (row % of probation/supervision)` = scales::percent(`Probation/Supervision, High Risk (N)`/`Probation/Supervision (N)`,
                                                                       accuracy = .1)) %>% 
  dplyr::mutate(`CSU` = "Overall") 

### combine two dataframes for table
df_complaints_disposition_outcome_table_risk_score_final_csu <- rbind(df_complaints_disposition_outcome_table_risk_score,df_complaints_disposition_outcome_table_overall)


### print table via kableextra
kable(df_complaints_disposition_outcome_table_risk_score_final_csu, 
      format.args = list(big.mark = ","), 
      align=rep('c')) %>%
  kable_styling(bootstrap_options = c("striped", 
                                       "hover", 
                                       "condensed", 
                                       "responsive"), 
                 row_label_position = "l") %>% 
  row_spec(33, bold = TRUE)
```



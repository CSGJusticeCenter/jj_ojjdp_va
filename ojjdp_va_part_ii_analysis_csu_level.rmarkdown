---
title: "Part II Analysis: CSU-Level Analysis"
format: html
---


**Data Sample:** 
 
* Juvenile intake complaints with intake dates from July 1, 2015 - June 30, 2021

* Dispositions – all dispositions for the intake complaints in the sample. 


**Intake Decision Coding Decisions (for part II analysis):**

* Diverted: "UNSUCCESSFUL DIVERSION/PETITION FILED", "SUCCESSFUL DIVERSION","UNSUCCESSFUL DIVERSION/NO PETITION FILED","REQ'D TO PARTICIPATE-DIVERSION"

* Diverted (Informal): "REFERRED TO ANOTHER AGY FOR SV","UNOFFICIAL COUNSELING-FAMILY C"

* Petitioned: "PETITION FILED", "PETITION/DETENTION ORDER FILED","COURT SUMMONS","PETITION/SHELTER CARE FILED"

* Resolved/Dismissed: "RESOLVED", "COMPLAINT UNFOUNDED"

* Other: "DETENTION ORDER ONLY","ACCEPTED VIA ICJ","RETURNED TO PROBATION SUPERVIS","PENDING","SHELTER CARE ONLY","RETURNED TO OUT-OF-STATE"


*Cohort:* All complaints from 2016-2021  

<br>


```{r include=FALSE}
### call libraries
library(easypackages)
libraries("tidyverse","foreign","lubridate","reshape2", "ggplot2","RColorBrewer","knitr","forcats","openxlsx","statar","svDialogs","xlsx", "magrittr","stringr", "data.table","janitor","kableExtra","leaflet", "readr", "rmarkdown","rowr", "gganimate", "gifski","tidycensus","sf","htmltools","acs","tigris","mapview","rgeos", "ggrepel", "censusxy","gdata","lavaan","mclust","tmap", "raster","rgeos","gmapsdistance","viridis","cowplot","lintr","leaflet.extras","censusapi","data.table","gridGraphics","readxl","haven","ggridges","extrafont","extrafontdb","datamodelr","Lahman","DiagrammeR","fs","readxl","rsvg","V8","csgjcr","DataExplorer","tidylog")
```

```{r include=FALSE,message=FALSE,warning=FALSE}
### set chunk output specifications
knitr::opts_chunk$set(
  echo = TRUE,
  dev = "ragg_png",
  cache = FALSE)

### set theme
theme_set(theme_minimal())

### set sharepoint path using csgjcr function
sharepoint_ojjdp_va_analysis_analytic_data <- csgjcr::csg_sp_path(file.path("JJ_OJJDP/Data/VA/analysis/analytic"))

### set sharepoint path using csgjcr function
sharepoint_ojjdp_va_viz <- csgjcr::csg_sp_path(file.path("JJ_OJJDP/Output/VA/r_viz_output"))
```

```{r include=FALSE}
### pull in virginia djj analytic files 

# ### read in df_analytic_complaints_disposition_caseload.rds analytic rds file 
# df_complaints_youth_intake_decision_csu <- read_rds(file.path(sharepoint_ojjdp_va_analysis_analytic_data,"df_complaints_youth_intake_decision_csu.rds"))
# 
# ### read in caseload_clean.rds analytic rds file 
# caseload_clean <- read_rds(file.path(sharepoint_ojjdp_va_analysis_analytic_data,"caseload_clean.rds"))

### read in df_analytic_complaints_disposition_caseload file for analysis
df_analytic_complaints_disposition_caseload <- read_rds(file.path(sharepoint_ojjdp_va_analysis_analytic_data,"df_analytic_complaints_disposition_caseload.rds"))
```

```{r include=FALSE,warning=FALSE,include=FALSE}
### create denominator -- unique complaint for entire sample
unique_complaints_sample_denom <- n_distinct(df_analytic_complaints_disposition_caseload$unique_complaint_id)

### create denominator -- unique youth for entire sample
unique_youth_sample_denom <- n_distinct(df_analytic_complaints_disposition_caseload$juvenile_number)
```


# Tables


## Table 1: Intake Decisions by Court Service Unit (CSU)

**Note:** I am currently coding the following intake decisions as 'Diverted': "UNSUCCESSFUL DIVERSION/PETITION FILED" (code of '18'), "SUCCESSFUL DIVERSION" (code of '20'), "UNSUCCESSFUL DIVERSION/NO PETITION FILED" (code of '21'), and "REQ'D TO PARTICIPATE-DIVERSION" (code of '7'). All other intake decisions are coded as "Not Diverted". See preliminary coding of intake decisions in `Intake Complaints, Intake Decision Descriptions` table on `codebook` page in `sample descriptives` tab


```{r echo=FALSE,message=FALSE,warning=FALSE}
#| column: page-right
#| out-width: 85%

### unique complaints split out
df_complaints_youth_intake_decision_table_csu <- df_analytic_complaints_disposition_caseload %>% 
  dplyr::group_by(csu) %>% 
  dplyr::summarise(`All Complaints (N)` = n_distinct(unique_complaint_id),
                   `All Complaints (column %)` = scales::percent(`All Complaints (N)`/unique_complaints_sample_denom,
                                                                       accuracy = .1),
                   `Complaints Petitioned (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Petitioned"]),
                   `Complaints Petitioned (row %)` = scales::percent(`Complaints Petitioned (N)`/`All Complaints (N)`,
                                                                       accuracy = .1),
                   `Complaints Diverted (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Diverted"]),
                   `Complaints Diverted (row %)` = scales::percent(`Complaints Diverted (N)`/`All Complaints (N)`,
                                                                       accuracy = .1),
                   `Complaints Resolved/Dismissed (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Resolved/Dismissed"]),
                   `Complaints Resolved/Dismissed (row %)` = scales::percent(`Complaints Resolved/Dismissed (N)`/`All Complaints (N)`,
                                                                       accuracy = .1),
                   `Other (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Other"]),
                   `Other (row %)` = scales::percent(`Other (N)`/`All Complaints (N)`,
                                                                       accuracy = .1)) %>% 
  ungroup() %>% 
  dplyr::rename(`CSU` = csu)  

### unique complaints statewide
df_complaints_youth_intake_decision_table_overall <- df_analytic_complaints_disposition_caseload %>% 
  dplyr::summarise(`All Complaints (N)` = n_distinct(unique_complaint_id),
                   `All Complaints (column %)` = scales::percent(`All Complaints (N)`/unique_complaints_sample_denom,
                                                                       accuracy = .1),
                   `Complaints Petitioned (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Petitioned"]),
                   `Complaints Petitioned (row %)` = scales::percent(`Complaints Petitioned (N)`/`All Complaints (N)`,
                                                                       accuracy = .1),
                   `Complaints Diverted (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Diverted"]),
                   `Complaints Diverted (row %)` = scales::percent(`Complaints Diverted (N)`/`All Complaints (N)`,
                                                                       accuracy = .1),
                   `Complaints Resolved/Dismissed (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Resolved/Dismissed"]),
                   `Complaints Resolved/Dismissed (row %)` = scales::percent(`Complaints Resolved/Dismissed (N)`/`All Complaints (N)`,
                                                                       accuracy = .1),
                   `Other (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Other"]),
                   `Other (row %)` = scales::percent(`Other (N)`/`All Complaints (N)`,
                                                                       accuracy = .1)) %>%  
  ungroup() %>% 
  dplyr::mutate(`CSU` = "Overall") 

### combine two dataframes for table
df_complaints_youth_intake_decision_table_csu_final <- rbind(df_complaints_youth_intake_decision_table_csu,
                                                             df_complaints_youth_intake_decision_table_overall)


### print table via kableextra
kable(df_complaints_youth_intake_decision_table_csu_final, 
      format.args = list(big.mark = ","), 
      align=rep('c')) %>%
  kable_styling(bootstrap_options = c("striped", 
                                       "hover", 
                                       "condensed", 
                                       "responsive"), 
                 row_label_position = "l") %>% 
  row_spec(33, bold = TRUE)
```


<br>

## Table 2: Intake Decisions by Court Service Unit (CSU) Region

**Note:** I am currently coding the following intake decisions as 'Diverted': "UNSUCCESSFUL DIVERSION/PETITION FILED" (code of '18'), "SUCCESSFUL DIVERSION" (code of '20'), "UNSUCCESSFUL DIVERSION/NO PETITION FILED" (code of '21'), and "REQ'D TO PARTICIPATE-DIVERSION" (code of '7'). All other intake decisions are coded as "Not Diverted". See preliminary coding of intake decisions in `Intake Complaints, Intake Decision Descriptions` table on `codebook` page in `sample descriptives` tab

See CSU regions here: https://www.djj.virginia.gov/pages/community/court-service-units.htm


```{r echo=FALSE,message=FALSE,warning=FALSE}
#| column: page-right
#| out-width: 85%


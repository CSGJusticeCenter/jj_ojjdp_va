  dplyr::group_by(csu) %>% 
   dplyr::summarise(`All Complaints (N)` = n_distinct(unique_complaint_id),
                   `All Complaints, School (N)` = n_distinct(unique_complaint_id[referral_source_clean_csu_level_categories=="School"]),
                   `All Complaints, School (row %)` = scales::percent(`All Complaints, School (N)`/`All Complaints (N)`,
                                                                       accuracy = .1),
                   `All Complaints, Law Enforcement (N)` = n_distinct(unique_complaint_id[referral_source_clean_csu_level_categories=="Law Enforcement"]),
                  `All Complaints, Law Enforcement (row %)` = scales::percent(`All Complaints, Law Enforcement (N)`/`All Complaints (N)`,
                                                                       accuracy = .1),
                   
                   `All Complaints, Other (N)` = n_distinct(unique_complaint_id[referral_source_clean_csu_level_categories=="Other"]),
                  `All Complaints, Other (row %)` = scales::percent(`All Complaints, Other (N)`/`All Complaints (N)`,
                                                                       accuracy = .1),
                  `Complaints Petitioned, School (row %)` = scales::percent(n_distinct(unique_complaint_id[intake_decision_clean=="Petitioned" & referral_source_clean_csu_level_categories=="School"])/`All Complaints (N)`,
                                                                       accuracy = .1),
                  `Complaints Petitioned, Law Enforcement (row %)` = scales::percent(n_distinct(unique_complaint_id[intake_decision_clean=="Petitioned" & referral_source_clean_csu_level_categories=="Law Enforcement"])/`All Complaints (N)`,
                                                                       accuracy = .1),
                  `Complaints Petitioned, Other (row %)` = scales::percent(n_distinct(unique_complaint_id[intake_decision_clean=="Petitioned" & referral_source_clean_csu_level_categories=="Other"])/`All Complaints (N)`,

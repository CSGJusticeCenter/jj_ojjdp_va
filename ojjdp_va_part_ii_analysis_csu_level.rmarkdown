## Table 9: Intake Decisions by Petitioner Type/Referral Source Rate (per 10k youth by CSU) (petitioned and diverted only)

**Question:** Should we use unique youth instead of complaints for rates?

**Note:** I am currently coding the following intake decisions as 'Diverted': "UNSUCCESSFUL DIVERSION/PETITION FILED" (code of '18'), "SUCCESSFUL DIVERSION" (code of '20'), "UNSUCCESSFUL DIVERSION/NO PETITION FILED" (code of '21'), and "REQ'D TO PARTICIPATE-DIVERSION" (code of '7'). All other intake decisions are coded as "Not Diverted". See preliminary coding of intake decisions in `Intake Complaints, Intake Decision Descriptions` table on `codebook` page in `sample descriptives` tab

**Also:** for this CSU-level analysis, I've further collapsed the petitioner/referral source categories for ease of interpretation.


```{r echo=FALSE,message=FALSE,warning=FALSE}
#| column: page-right
#| out-width: 85%

#### read in county-level youth population data from ezapop
df_acs_bridged_age_race_sex_15_19_final_va <- read_rds(file.path(sharepoint_ojjdp_va_analysis_analytic_data,"df_acs_bridged_age_race_sex_15_19_final_va.rds"))

### create lookup table of county fips code and csu to join to df_acs_bridged_age_race_sex_15_19_final_va
df_county_fips_csu_lookup <- df_analytic_complaints_disposition_caseload %>%
  mutate(fips_code = ifelse(fips_code=="X71",
                            "071",fips_code),
         fips_code = ifelse(fips_code=="X21",
                            "021",fips_code)) %>%
  distinct(fips_code,
           .keep_all = TRUE) %>% 
  dplyr::select(county_code=fips_code,
                csu)

### join df_acs_bridged_age_race_sex_15_19_final_va and df_county_fips_csu_lookup 
### summarize raw population count by csu
df_va_csu_youth_population_8_17 <- left_join(df_acs_bridged_age_race_sex_15_19_final_va,
                                              df_county_fips_csu_lookup,
                                             by = "county_code") %>% 
  dplyr::group_by(csu) %>% 
  dplyr::summarise(overall_8_17_population = sum(overall_8_17_population,
                                                 na.rm = TRUE)) %>% 
  ungroup()

### create quantiles object
no_classes <- 4

### extract quantiles from var we're mapping
quantiles <- df_va_csu_youth_population_8_17 %>%
  pull(overall_8_17_population) %>%
  quantile(probs = seq(0, 1, length.out = no_classes + 1), na.rm=TRUE) %>%
  as.vector() 

### make labels for map's legend
label_petition_rate <- c("42,200 to 154,400","23,100 to 42,200","14,000 to 23,100","5,100 to 14,000")

### create a new variable with the specified quantiles
df_va_csu_youth_population_8_17 %<>%
  mutate(youth_pop_quartile = cut(-overall_8_17_population,
                               breaks = -quantiles,
                               right = TRUE,
                               labels = label_petition_rate,
                               include.lowest = T))

### Intake Decisions by Petitioner Type/Referral Source (per 10k youth by CSU)
df_complaints_youth_intake_decision_pet_desc_rate_csu <- df_analytic_complaints_disposition_caseload %>% 
  filter(!is.na(referral_source_clean_csu_level_categories)==TRUE) %>% 
  dplyr::group_by(csu) %>% 
   dplyr::summarise(`All Complaints (N)` = n_distinct(unique_complaint_id),
                   `All Complaints, School (N)` = n_distinct(unique_complaint_id[referral_source_clean_csu_level_categories=="School"]),
                   `All Complaints, Law Enforcement (N)` = n_distinct(unique_complaint_id[referral_source_clean_csu_level_categories=="Law Enforcement"]),
                   `All Complaints, Other (N)` = n_distinct(unique_complaint_id[referral_source_clean_csu_level_categories=="Other"]),
                  `Complaints Petitioned, School (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Petitioned" & referral_source_clean_csu_level_categories=="School"]),
                  `Complaints Petitioned, Law Enforcement (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Petitioned" & referral_source_clean_csu_level_categories=="Law Enforcement"]),
                  `Complaints Petitioned, Other (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Petitioned" & referral_source_clean_csu_level_categories=="Other"]),
                   `Complaints Diverted, School (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Diverted" & referral_source_clean_csu_level_categories=="School"]),
                  `Complaints Diverted, Law Enforcement (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Diverted" & referral_source_clean_csu_level_categories=="Law Enforcement"]),
                  `Complaints Diverted, Other (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Diverted" & referral_source_clean_csu_level_categories=="Other"])) %>% 
  ungroup() %>% 
  left_join(df_va_csu_youth_population_8_17,
            by = "csu") %>% 
  dplyr::group_by(csu) %>% 
   dplyr::summarise(`All Complaints Rate (per 10k youth)` = `All Complaints (N)`/overall_8_17_population*10000,
                   `All Complaints, School Rate (per 10k youth)` = `All Complaints, School (N)`/overall_8_17_population*10000,
                   `All Complaints, Law Enforcement Rate (per 10k youth)` = `All Complaints, Law Enforcement (N)`/overall_8_17_population*10000,
                   `All Complaints, Other Rate (per 10k youth)` = `All Complaints, Other (N)`/overall_8_17_population*10000,
                  `Complaints Petitioned, School Rate (per 10k youth)` = `Complaints Petitioned, School (N)`/overall_8_17_population*10000,
                  `Complaints Petitioned, Law Enforcement Rate (per 10k youth)` = `Complaints Petitioned, Law Enforcement (N)`/overall_8_17_population*10000,
                  `Complaints Petitioned, Other Rate (per 10k youth)` = `Complaints Petitioned, Other (N)`/overall_8_17_population*10000,
                   `Complaints Diverted, School Rate (per 10k youth)` = `Complaints Diverted, School (N)`/overall_8_17_population*10000,
                  `Complaints Diverted, Law Enforcement Rate (per 10k youth)` = `Complaints Diverted, Law Enforcement (N)`/overall_8_17_population*10000,
                  `Complaints Diverted, Other Rate (per 10k youth)` = `Complaints Diverted, Other (N)`/overall_8_17_population*10000) %>% 
  dplyr::rename(`CSU` = csu) 



### print table via kableextra
kable(df_complaints_youth_intake_decision_pet_desc_rate_csu, 
      format.args = list(big.mark = ","), 
      align=rep('c')) %>%
  kable_styling(bootstrap_options = c("striped", 
                                       "hover", 
                                       "condensed", 
                                       "responsive"), 
                 row_label_position = "l") 
```


<br>


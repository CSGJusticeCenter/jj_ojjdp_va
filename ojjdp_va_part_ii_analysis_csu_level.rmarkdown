                  `Complaints Diverted, Law Enforcement (row %)` = scales::percent(n_distinct(unique_complaint_id[intake_decision_clean=="Diverted" & referral_source_clean_csu_level_categories=="Law Enforcement"])/`All Complaints (N)`,
                                                                       accuracy = .1),
                  `Complaints Diverted, Other (row %)` = scales::percent(n_distinct(unique_complaint_id[intake_decision_clean=="Diverted" & referral_source_clean_csu_level_categories=="Other"])/`All Complaints (N)`,
                                                                       accuracy = .1)) %>% 
  ungroup() %>% 
  dplyr::rename(`CSU` = csu) 

### unique complaints statewide
df_complaints_youth_intake_decision_table_overall <- df_analytic_complaints_disposition_caseload %>% 
  filter(!is.na(referral_source_clean_csu_level_categories)==TRUE) %>% 
   dplyr::summarise(`All Complaints (N)` = n_distinct(unique_complaint_id),
                   `All Complaints, School (N)` = n_distinct(unique_complaint_id[referral_source_clean_csu_level_categories=="School"]),

                   `Fine (row %)` = scales::percent(`Fine (N)`/`All Disposed Complaints (N)`,
                                                                       accuracy = .1),
                   `No further action/none (N)` = n_distinct(unique_complaint_id[dispo_description_clean=="No further action/none"]),
                   `No further action/none (row %)` = scales::percent(`No further action/none (N)`/`All Disposed Complaints (N)`,
                                                                       accuracy = .1),
                   `Restitution (N)` = n_distinct(unique_complaint_id[dispo_description_clean=="Restitution"]),
                   `Restitution (row %)` = scales::percent(`Restitution (N)`/`All Disposed Complaints (N)`,
                                                                       accuracy = .1),
                   `Other (N)` = n_distinct(unique_complaint_id[dispo_description_clean=="Other"]),
                   `Other (row %)` = scales::percent(`Other (N)`/`All Disposed Complaints (N)`,
                                                                       accuracy = .1)) %>% 
  ungroup() %>% 
  dplyr::mutate(`CSU` = "Overall") 

### combine two dataframes for table
df_complaints_disposition_outcome_table_csu_final <- rbind(df_complaints_disposition_outcome_table_csu,
                                                             df_complaints_disposition_outcome_table_overall)


### print table via kableextra
kable(df_complaints_disposition_outcome_table_csu_final, 
      format.args = list(big.mark = ","), 
      align=rep('c')) %>%
  kable_styling(bootstrap_options = c("striped", 
                                       "hover", 
                                       "condensed", 
                                       "responsive"), 
                 row_label_position = "l") %>% 
  row_spec(33, bold = TRUE)
```


<br>

## Table 5: Average Length of Stay on Diversion by CSU

**NOTE:** This table includes all charge types and is simply filtered on youth diverted at intake.

Both measures of LOS on diversion are calculated by DJJ and provided in the `caseload` file -- see codebook page for more information. The two LOS measures are the "Number of days on the workload status "Diversion at Intake" and the "Number of days on the workload status "Diversion Beyond 90 Days"


```{r echo=FALSE,message=FALSE,warning=FALSE}
#| column: page-right
#| out-width: 85%

###  mean and median diversion lengths of stay by race/ethnicity
df_diversion_csu_los <- df_analytic_complaints_disposition_caseload %>% 
   filter(intake_decision_clean=="Diverted") %>% 
  filter(!is.na(div_at_int)==TRUE | !is.na(div_bey_90)==TRUE) %>% 
  group_by(csu) %>% 
  dplyr::summarise(`Mean Diversion LOS (at intake)` = mean(div_at_int,
                                           na.rm=TRUE),
                   `Median Diversion LOS (at intake)` = median(div_at_int,
                                           na.rm=TRUE),
                   `Mean Diversion LOS (beyond 90 days)` = mean(div_bey_90,
                                           na.rm=TRUE),
                   `Median Diversion LOS (beyond 90 days)` = median(div_bey_90,
                                           na.rm=TRUE)) %>% 
  ungroup() %>% 
  dplyr::rename(`CSU` = csu)

### overall mean and median diversion lengths of stay
df_diversion_overall_los <- df_analytic_complaints_disposition_caseload %>% 
   filter(intake_decision_clean=="Diverted") %>% 
  filter(!is.na(div_at_int)==TRUE | !is.na(div_bey_90)==TRUE) %>% 
  dplyr::summarise(`Mean Diversion LOS (at intake)` = mean(div_at_int,
                                           na.rm=TRUE),
                   `Median Diversion LOS (at intake)` = median(div_at_int,
                                           na.rm=TRUE),
                   `Mean Diversion LOS (beyond 90 days)` = mean(div_bey_90,
                                           na.rm=TRUE),
                   `Median Diversion LOS (beyond 90 days)` = median(div_bey_90,
                                           na.rm=TRUE)) %>% 
  mutate(`CSU` = "Overall")
 
### combine two dataframes for table
df_diversion_csu_los_final <- rbind(df_diversion_csu_los,
                                                             df_diversion_overall_los)

### print table via kableextra
kable(df_diversion_csu_los_final, 
      format.args = list(big.mark = ","), 
      align=rep('c')) %>%
  kable_styling(bootstrap_options = c("striped", 
                                       "hover", 
                                       "condensed", 
                                       "responsive"), 
                 row_label_position = "l") %>% 
  row_spec(33, bold = TRUE)
```


<br>


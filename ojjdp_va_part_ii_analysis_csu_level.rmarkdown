### Slide 25. 


```{r echo=FALSE,message=FALSE,warning=FALSE}
#| column: page-right
#| out-width: 100%

### unique complaints split out
df_complaints_youth_intake_decision_table_offense_status <- df_analytic_complaints_disposition_caseload %>% 
  filter(dai%in%c("Status Offense")) %>% 
  dplyr::group_by(csu) %>% 
  dplyr::summarise(`All Status Complaints (N)` = n_distinct(unique_complaint_id),
                   `Status Complaints Petitioned (N)` = n_distinct(unique_complaint_id[intake_decision_clean=="Petitioned"]),
                   `Status Complaints Petitioned (row %)` =`Status Complaints Petitioned (N)`/`All Status Complaints (N)`) %>% 
  ungroup()   
                 
df_csu_level_intake_summary_geo_to_map_slide_25 <- left_join(df_csu_level_intake_summary_geo_to_map,
                                                         df_complaints_youth_intake_decision_table_offense_status,
                                                         by = "csu")
                 


### create quantiles object
no_classes <- 4

### extract quantiles from var we're mapping
quantiles <- df_csu_level_intake_summary_geo_to_map_slide_25 %>%
  pull(`Status Complaints Petitioned (row %)`) %>%
  quantile(probs = seq(0, 1, length.out = no_classes + 1), na.rm=TRUE) %>%
  as.vector() 

### make labels for map's legend
label <- c("71% to 87%","56% to 71%","38% to 56%","15% to 38%")

### create a new variable with the specified quantiles
df_csu_level_intake_summary_geo_to_map_slide_25 <- df_csu_level_intake_summary_geo_to_map_slide_25 %>%
  mutate(status_petition_quartile = cut(-`Status Complaints Petitioned (row %)`,
                               breaks = -quantiles,
                               right = TRUE,
                               labels = label,
                               include.lowest = T)) 


### map via ggplot 
ggplot(
  # define main data source
  data = df_csu_level_intake_summary_geo_to_map_slide_25
) +
  scale_alpha(name = "",
              range = c(0.6, 0),
              guide = F) + # suppress legend
  # add main fill aesthetic
  geom_sf(
    mapping = aes(
      fill = status_petition_quartile
      ),
    color = "white",
    size = 0.1
  ) +
  #   scale_fill_distiller(
  #   labels = scales::percent_format(accuracy=1),
  #   direction = 1,
  #   name = "% Bookings with Drug/Alcohol\n Charges"
  # ) +
  ### use jr palette here
    # scale_colour_gradientn(colours = c("#D7EBF1","#AFD6E2","#87C2D4","#2F7084","#1F4A58")) +
 scale_fill_manual(
    values = c("#1F4A58","#2F7084","#87C2D4","#AFD6E2"),
    name = "% of Status Complaints Petitioned at Intake",
    na.value = "grey50",
    guide = guide_legend(
     keyheight = unit(7.5, units = "mm"),
     title.position = "top",
     reverse = F # display highest on top
  )) +
  # use white stroke borders for county boundaries
  geom_sf(
    data = df_county_level_intake_summary_geo_to_map,
    fill = "transparent",
    color = "white",
    linewidth = .05
  ) +
  # use white stroke borders for csu boundaries
  geom_sf(
    data = df_csu_level_intake_summary_geo_to_map_slide_25,
    fill = "transparent",
    color = "white",
    linewidth = .65
  )  +
  # use additional csu region-level shapefile for region border
  # geom_sf(
  #   data = df_csu_region_level_intake_summary_geo,
  #   fill = "transparent",
  #   color = "grey20",
  #   size = .35
  # )  + 
 # geom_label(
 #     data = df_csu_level_intake_summary_geo_to_map,
 #     aes(geometry = geometry,
 #         label = paste0(csu)),
 # family = "Franklin Gothic Demi",
 # color = "gray25",
 # size = 3,
 # fontface = "bold",
 # stat = "sf_coordinates") +
 # guides(fill = guide_colorbar(barwidth = 8),
 #          direction = "horizontal",
 #     barheight = unit(2, units = "mm"),
 #     barwidth = unit(50, units = "mm"),
 #     draw.ulim = F,
 #     title.position = 'top',
 #     # some shifting around
 #     title.hjust = 0.5,
 #     label.hjust = 0.5) +
 #  labs(
 #    title = NULL,
 #    subtitle = NULL,
 #    x = NULL,
 #    y = NULL,
 #    fill = NULL,
 #    caption = NULL
 #  ) +
  # add theme
  theme_map() 

### write out
ggsave(
    filename = file.path(sharepoint_ojjdp_va_viz, "slide_25_csu_level_percent_of_complaints_status_petitioned.png"),
    plot = last_plot(),
    device = ragg::agg_png,
    dpi = 300,
    height = 5.25,
    width = 10,
    units = "in",
    bg = "transparent"
  )

### unique complaints split out
df_complaints_youth_intake_decision_table_offense_status <- df_analytic_complaints_disposition_caseload %>% 
  dplyr::group_by(csu) %>% 
  dplyr::summarise(`All Complaints (N)` = n_distinct(unique_complaint_id),
                   `All Status Complaints (N)` = n_distinct(unique_complaint_id[dai=="Status Offense"]),
                   `All Status Complaints (row %)` = `All Status Complaints (N)`/`All Complaints (N)`) %>% 
  ungroup() 
                 
df_csu_level_intake_summary_geo_to_map_slide_19 <- left_join(df_csu_level_intake_summary_geo_to_map,
                                                         df_complaints_youth_intake_decision_table_offense_status,
                                                         by = "csu")
                 


### map via ggplot 
ggplot(
  # define main data source
  data = df_csu_level_intake_summary_geo_to_map_slide_19
) +
  scale_alpha(name = "",
              range = c(0.6, 0),
              guide = F) + # suppress legend
  # add main fill aesthetic
  geom_sf(
    mapping = aes(
      fill = `All Status Complaints (row %)`
      ),
    color = "white",
    size = 0.1
  ) +
    scale_fill_distiller(
    labels = scales::percent_format(accuracy=1),
    direction = 1,
    name = "% of Complaints for Status Offenses"
  ) +
  ### use jr palette here
    scale_colour_gradientn(colours = c("#D7EBF1","#AFD6E2","#87C2D4","#2F7084","#1F4A58")) +
 # scale_fill_manual(
 #    values = c("#1F4A58","#2F7084","#87C2D4","#AFD6E2"),
 #    name = "% of Complaints Diverted",
 #    na.value = "grey50",
 #    guide = guide_legend(
 #     keyheight = unit(7.5, units = "mm"),
 #     title.position = "top",
 #     reverse = F # display highest on top
  # )) +
  # use white stroke borders for county boundaries
  geom_sf(
    data = df_county_level_intake_summary_geo_to_map,
    fill = "transparent",
    color = "white",
    linewidth = .05
  ) +
  # use white stroke borders for csu boundaries
  geom_sf(
    data = df_csu_level_intake_summary_geo_to_map_slide_19,
    fill = "transparent",
    color = "white",
    linewidth = .65
  )  +
  # use additional csu region-level shapefile for region border
  # geom_sf(
  #   data = df_csu_region_level_intake_summary_geo,
  #   fill = "transparent",
  #   color = "grey20",
  #   size = .35
  # )  + 
 # geom_label(
 #     data = df_csu_level_intake_summary_geo_to_map,
 #     aes(geometry = geometry,
 #         label = paste0(csu)),
 # family = "Franklin Gothic Demi",
 # color = "gray25",
 # size = 3,
 # fontface = "bold",
 # stat = "sf_coordinates") +
 guides(fill = guide_colorbar(barwidth = 8),
          direction = "horizontal",
     barheight = unit(2, units = "mm"),
     barwidth = unit(50, units = "mm"),
     draw.ulim = F,
     title.position = 'top',
     # some shifting around
     title.hjust = 0.5,
     label.hjust = 0.5) +
 #  labs(
 #    title = NULL,
 #    subtitle = NULL,
 #    x = NULL,
 #    y = NULL,
